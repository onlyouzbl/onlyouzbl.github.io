<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page.title | escape }} · Ningbo University</title>
    <meta name="description" content="{{ page.description | escape }}">
    <style>
      * { box-sizing: border-box; }
      body { margin: 0; color: #20313b; background: #fff; font: 1rem/1.7 system-ui, sans-serif; }
      header, main { max-width: 66rem; margin: auto; padding-inline: clamp(1.25rem, 5vw, 3rem); }
      header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 1rem; padding-block: 1.25rem; border-bottom: 1px solid #dce3e7; }
      h1, h2 { font-family: Georgia, serif; color: #18344d; line-height: 1.2; }
      h1 { margin: 0; font-size: clamp(1.7rem, 4vw, 2.5rem); }
      h2 { margin: 0 0 .75rem; font-size: clamp(1.4rem, 3vw, 1.9rem); }
      a { color: #175678; text-underline-offset: .18em; }
      p { margin: .45rem 0; max-width: 76ch; }
      section { padding-block: clamp(1.5rem, 4vw, 2.6rem); border-bottom: 1px solid #dce3e7; }
      .intro { display: grid; grid-template-columns: minmax(10rem, 1fr) 2fr; align-items: center; gap: clamp(1.5rem, 4vw, 3rem); }
      .intro img { width: 100%; max-width: 19rem; height: auto; }
      .motto { display: flex; flex-wrap: wrap; gap: .25rem 1rem; margin-top: 1.1rem; color: #185b62; }
      main { padding-bottom: 2rem; }
      h3 { margin: 1.3rem 0 .25rem; color: #18344d; font-size: 1.08rem; }
      .lab-lead h3, .cohort h3 { margin-top: 0; }
      .lab-lead { padding-block: .6rem 1.3rem; }
      .cohort { display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem; padding-top: 1.25rem; border-top: 1px solid #dce3e7; }
      .students { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.1rem; }
      .student-photo { width: 5.25rem; aspect-ratio: 4 / 5; margin-left: auto; background: #f6f8fa; border: 1px dashed #aab9c2; border-radius: .25rem; }
      .student { padding: .9rem; border: 1px solid #dce3e7; border-radius: .35rem; }
      .student dl { margin-bottom: 0; }
      .student dt { color: #546975; font-size: .82rem; }
      .student dd { margin: 0 0 .4rem; min-height: .65rem; border-bottom: 1px solid #e2e8eb; }
      .research-row { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: clamp(1rem, 4vw, 2.5rem); align-items: center; padding-block: 1.1rem; }
      .research-row + .research-row { border-top: 1px solid #e8edee; }
      .research-row h3 { margin-top: 0; }
      .research-media { position: relative; }
      .research-media img { display: block; width: 100%; height: auto; border-radius: .7rem; }
      .research-media button { position: absolute; right: .4rem; bottom: .35rem; color: #18344d; background: #fff; border: 1px solid #bbcacc; border-radius: .8rem; padding: .2rem .65rem; cursor: pointer; }
      summary { color: #175678; font-weight: 650; cursor: pointer; }
      .lab-publications { margin-top: .8rem; }
      .lab-publications li { margin-block: 1rem; }
      .lab-publications .venue { font-style: italic; }
      .activity-gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 1rem; }
      .activity-gallery figure { margin: 0; }
      .activity-gallery img { width: 100%; height: auto; border-radius: .5rem; }
      @media (max-width: 38rem) { .research-row { grid-template-columns: 1fr; } }
      @media (max-width: 48rem) { .cohort { grid-template-columns: 1fr; } }
      @media (max-width: 38rem) { .intro { grid-template-columns: 1fr; } .intro img { max-width: 14rem; } }
    </style>
  </head>
  <body>
    <header><h1>LIN-AI Lab</h1><a href="/">Back to homepage</a></header>
    <main>{{ content }}</main>
    <script defer src="/assets/js/lab-animations.js"></script>

  </body>
</html>
