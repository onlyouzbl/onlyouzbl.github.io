<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page.title | escape }} · Ningbo University</title>
    <meta name="description" content="{{ page.description | escape }}">
    <style>
      * { box-sizing: border-box; }
      body { margin: 0; color: #20313b; background: #fff; font: 1rem/1.7 system-ui, sans-serif; }
      header, main, footer { max-width: 66rem; margin: auto; padding-inline: clamp(1.25rem, 5vw, 3rem); }
      header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 1rem; padding-block: 1.25rem; border-bottom: 1px solid #dce3e7; }
      h1, h2 { font-family: Georgia, serif; color: #18344d; line-height: 1.2; }
      h1 { margin: 0; font-size: clamp(1.7rem, 4vw, 2.5rem); }
      h2 { margin: 0 0 .75rem; font-size: clamp(1.4rem, 3vw, 1.9rem); }
      a { color: #175678; text-underline-offset: .18em; }
      p { margin: .45rem 0; max-width: 76ch; }
      section { padding-block: clamp(1.5rem, 4vw, 2.6rem); border-bottom: 1px solid #dce3e7; }
      .intro { display: grid; grid-template-columns: minmax(10rem, 1fr) 2fr; align-items: center; gap: clamp(1.5rem, 4vw, 3rem); }
      .intro img { width: 100%; max-width: 19rem; height: auto; }
      .motto { display: flex; flex-wrap: wrap; gap: .25rem 1rem; margin-top: 1.1rem; color: #185b62; }
      footer { padding-block: 1.25rem 2.5rem; }
      @media (max-width: 38rem) { .intro { grid-template-columns: 1fr; } .intro img { max-width: 14rem; } }
    </style>
  </head>
  <body>
    <header><h1>LIN-AI Lab</h1><a href="/">Back to homepage</a></header>
    <main>{{ content }}</main>
    <footer><a href="/#publications">View Bolin Zhang’s publications</a></footer>
  </body>
</html>
