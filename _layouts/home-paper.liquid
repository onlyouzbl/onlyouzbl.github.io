<article class="paper" id="paper-{{ entry.key }}">
  <span class="venue-tag">{% if entry.note == 'Accepted' %}Accepted{% else %}{{ entry.abbr | default: entry.journal | default: entry.booktitle | escape }}{% endif %} · {{ entry.year }}</span>
  <div>
    <h3>
      {% if entry.doi -%}
        <a href="https://doi.org/{{ entry.doi | escape }}">{{ entry.title | escape }}</a>
      {%- elsif entry.url -%}
        <a href="{{ entry.url | escape }}">{{ entry.title | escape }}</a>
      {%- else -%}
        {{- entry.title | escape -}}
      {%- endif %}
    </h3>
    <p class="authors">{% include home-authors.liquid %}</p>
    <p class="venue">{{ entry.journal | default: entry.booktitle }}, {{ entry.year }}.</p>
    {% if entry.annotation %}
      <p class="paper-summary">{{ entry.annotation }}</p>
    {% endif %}
    <div class="resources">
      {% if entry.doi -%}
        <a href="https://doi.org/{{ entry.doi | escape }}">Paper</a>
      {%- endif %}
      {% if entry.html -%}
        <a href="{{ entry.html }}">Project</a>
      {%- endif %}
      {% if entry.code -%}
        <a href="{{ entry.code }}">Code</a>
      {%- endif %}
      {% if entry.pdf -%}
        <a href="{{ entry.pdf | escape }}">PDF</a>
      {%- endif %}
    </div>
    <div class="disclosures">
      {% if entry.abstract %}
        <details>
          <summary>Abstract</summary>
          <p>{{ entry.abstract }}</p>
        </details>
      {% endif %}
      <details>
        <summary>BibTeX</summary>
        <pre><code>{{ entry.bibtex | hideCustomBibtex | escape }}</code></pre>
      </details>
    </div>
  </div>
</article>
